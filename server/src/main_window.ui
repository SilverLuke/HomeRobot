<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkApplicationWindow" id="main_window">
    <property name="title">HomeRobot Control Center</property>
    <property name="default-width">1200</property>
    <property name="default-height">800</property>
    
    <child type="titlebar">
      <object class="GtkHeaderBar">
        <child type="start">
          <object class="GtkToggleButton" id="btn_toggle_sidebar">
            <property name="icon-name">sidebar-show-symbolic</property>
            <property name="tooltip-text">Toggle Sidebar (H)</property>
            <property name="active">true</property>
          </object>
        </child>
        <child type="start">
          <object class="GtkButton" id="btn_clear_path">
            <property name="icon-name">edit-clear-all-symbolic</property>
            <property name="tooltip-text">Clear Robot Path</property>
            <property name="focusable">false</property>
          </object>
        </child>
        <child type="start">
          <object class="GtkToggleButton" id="btn_explore">
            <property name="icon-name">media-record-symbolic</property>
            <property name="tooltip-text">Autonomous Exploration</property>
            <property name="focusable">false</property>
          </object>
        </child>
        <child type="start">
          <object class="GtkButton" id="btn_save_map">
            <property name="icon-name">document-save-symbolic</property>
            <property name="tooltip-text">Save Map to house_map.pgm</property>
            <property name="focusable">false</property>
          </object>
        </child>
        <child type="start">
          <object class="GtkToggleButton" id="btn_lidar">
            <property name="icon-name">sensors-symbolic</property>
            <property name="tooltip-text">Toggle LiDAR Streaming (L)</property>
            <property name="focusable">false</property>
          </object>
        </child>
        <child type="start">
          <object class="GtkButton" id="btn_start_rerun">
            <property name="icon-name">media-playback-start-symbolic</property>
            <property name="tooltip-text">Start Rerun Viewer</property>
            <property name="focusable">false</property>
          </object>
        </child>
        <child type="start">
          <object class="GtkButton" id="btn_zoom_in">
            <property name="icon-name">zoom-in-symbolic</property>
            <property name="tooltip-text">Zoom In (+)</property>
            <property name="focusable">false</property>
          </object>
        </child>
        <child type="start">
          <object class="GtkButton" id="btn_zoom_out">
            <property name="icon-name">zoom-out-symbolic</property>
            <property name="tooltip-text">Zoom Out (-)</property>
            <property name="focusable">false</property>
          </object>
        </child>
        <child type="start">
          <object class="GtkButton" id="btn_reset">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text">Reset Simulation Pose &amp; Map</property>
            <property name="focusable">false</property>
            <style>
              <class name="destructive-action"/>
            </style>
          </object>
        </child>
        <child type="end">
          <object class="GtkLabel" id="battery_label">
            <property name="label">Battery: --% (-- mV)</property>
            <property name="margin-end">12</property>
          </object>
        </child>
        <child type="end">
          <object class="GtkLabel" id="scan_rate_label">
            <property name="label">LiDAR: -- Hz</property>
            <property name="margin-end">8</property>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="GtkOverlay" id="main_overlay">
        <child>
          <object class="GtkPaned" id="main_paned">
        <property name="shrink-start-child">false</property>
        <property name="shrink-end-child">false</property>
        <property name="resize-start-child">false</property>
        <property name="resize-end-child">true</property>
        <property name="position">450</property>

        <child type="start">
          <object class="GtkScrolledWindow" id="sidebar_scroll">
            <property name="hscrollbar-policy">never</property>
            <property name="vscrollbar-policy">automatic</property>
            <property name="min-content-width">450</property>
            <property name="propagate-natural-width">true</property>
            <child>
              <object class="GtkBox" id="sidebar_container">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <property name="margin-start">6</property>
                <property name="margin-end">6</property>
                <property name="margin-top">6</property>
                <property name="margin-bottom">6</property>



                <!-- Manual Control Buttons (Moved to Top) -->
                <child>
                  <object class="GtkExpander">
                    <property name="label">Manual Control</property>
                    <property name="expanded">true</property>
                    <child>
                      <object class="GtkFrame">
                        <child>
                          <object class="GtkGrid">
                            <property name="halign">center</property>
                            <property name="valign">center</property>
                            <property name="margin-start">10</property>
                            <property name="margin-end">10</property>
                            <property name="margin-top">10</property>
                            <property name="margin-bottom">10</property>
                            <property name="row-spacing">6</property>
                            <property name="column-spacing">6</property>

                            <child>
                              <object class="GtkButton" id="btn_rotate_left">
                                <property name="label">↺</property>
                                <property name="focusable">false</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="btn_forward">
                                <property name="label">▲</property>
                                <property name="focusable">false</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="btn_rotate_right">
                                <property name="label">↻</property>
                                <property name="focusable">false</property>
                                <layout>
                                  <property name="column">2</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="btn_left">
                                <property name="label">◀</property>
                                <property name="focusable">false</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="btn_stop">
                                <property name="label">■</property>
                                <property name="focusable">false</property>
                                <style>
                                  <class name="destructive-action"/>
                                </style>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="btn_right">
                                <property name="label">▶</property>
                                <property name="focusable">false</property>
                                <layout>
                                  <property name="column">2</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="btn_backward">
                                <property name="label">▼</property>
                                <property name="focusable">false</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Motor Configuration -->
                <child>
                  <object class="GtkExpander">
                    <property name="label">Motor Configs</property>
                    <property name="expanded">true</property>
                    <child>
                      <object class="GtkFrame">
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">10</property>
                            <property name="margin-end">10</property>
                            <property name="margin-top">10</property>
                            <property name="margin-bottom">10</property>
                            <child>
                              <object class="GtkGrid">
                                <property name="row-spacing">6</property>
                                <property name="column-spacing">12</property>

                                <!-- Header Row -->
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Left</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Right</property>
                                    <layout>
                                      <property name="column">3</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>

                                <!-- Row 1: P -->
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">P</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">1</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSpinButton" id="kp_left">
                                    <property name="focusable">false</property>
                                    <property name="can-focus">false</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">100</property>
                                        <property name="step-increment">0.01</property>
                                        <property name="page-increment">0.1</property>
                                      </object>
                                    </property>
                                    <property name="digits">3</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">1</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkToggleButton" id="btn_lock_pid">
                                    <property name="label">🔒</property>
                                    <property name="active">true</property>
                                    <property name="focusable">false</property>
                                    <layout>
                                      <property name="column">2</property>
                                      <property name="row">1</property>
                                      <property name="row-span">3</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSpinButton" id="kp_right">
                                    <property name="focusable">false</property>
                                    <property name="can-focus">false</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">100</property>
                                        <property name="step-increment">0.01</property>
                                        <property name="page-increment">0.1</property>
                                      </object>
                                    </property>
                                    <property name="digits">3</property>
                                    <layout>
                                      <property name="column">3</property>
                                      <property name="row">1</property>
                                    </layout>
                                  </object>
                                </child>

                                <!-- Row 2: I -->
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">I</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">2</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSpinButton" id="ki_left">
                                    <property name="focusable">false</property>
                                    <property name="can-focus">false</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">100</property>
                                        <property name="step-increment">0.001</property>
                                        <property name="page-increment">0.01</property>
                                      </object>
                                    </property>
                                    <property name="digits">3</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">2</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSpinButton" id="ki_right">
                                    <property name="focusable">false</property>
                                    <property name="can-focus">false</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">100</property>
                                        <property name="step-increment">0.001</property>
                                        <property name="page-increment">0.01</property>
                                      </object>
                                    </property>
                                    <property name="digits">3</property>
                                    <layout>
                                      <property name="column">3</property>
                                      <property name="row">2</property>
                                    </layout>
                                  </object>
                                </child>

                                <!-- Row 3: D -->
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">D</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">3</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSpinButton" id="kd_left">
                                    <property name="focusable">false</property>
                                    <property name="can-focus">false</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">100</property>
                                        <property name="step-increment">0.01</property>
                                        <property name="page-increment">0.1</property>
                                      </object>
                                    </property>
                                    <property name="digits">3</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">3</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSpinButton" id="kd_right">
                                    <property name="focusable">false</property>
                                    <property name="can-focus">false</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">100</property>
                                        <property name="step-increment">0.01</property>
                                        <property name="page-increment">0.1</property>
                                      </object>
                                    </property>
                                    <property name="digits">3</property>
                                    <layout>
                                      <property name="column">3</property>
                                      <property name="row">3</property>
                                    </layout>
                                  </object>
                                </child>

                                <!-- Row 4: Apply Button -->
                                <child>
                                  <object class="GtkButton" id="apply_config">
                                    <property name="focusable">false</property>
                                    <property name="can-focus">false</property>
                                    <property name="label">Apply Settings</property>
                                    <property name="halign">center</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">4</property>
                                      <property name="column-span">4</property>
                                    </layout>
                                  </object>
                                </child>
                              </object>
                            </child>

                            <child>
                              <object class="GtkSeparator">
                                <property name="orientation">horizontal</property>
                              </object>
                            </child>

                            <!-- Global Propulsion Power Control -->
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">6</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Max Motor Power (Global Propulsion)</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkScale" id="global_power_scale">
                                    <property name="focusable">false</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">255</property>
                                        <property name="value">127</property>
                                        <property name="step-increment">1</property>
                                      </object>
                                    </property>
                                    <property name="value-pos">right</property>
                                    <property name="draw-value">true</property>
                                  </object>
                                </child>
                              </object>
                            </child>

                            <child>
                              <object class="GtkSeparator">
                                <property name="orientation">horizontal</property>
                              </object>
                            </child>

                            <!-- Lidar Spinning Velocity Control -->
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">6</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Lidar Spinning Velocity (Hz)</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkScale" id="lidar_freq_scale">
                                    <property name="focusable">false</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">5</property>
                                        <property name="upper">10</property>
                                        <property name="value">5</property>
                                        <property name="step-increment">1</property>
                                      </object>
                                    </property>
                                    <property name="value-pos">right</property>
                                    <property name="draw-value">true</property>
                                    <property name="round-digits">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Encoders & Speed -->
                <child>
                  <object class="GtkExpander">
                    <property name="label">Odometry &amp; Dynamics</property>
                    <property name="expanded">true</property>
                    <child>
                      <object class="GtkFrame">
                        <child>
                          <object class="GtkListBox">
                            <property name="selection-mode">none</property>
                            <child>
                              <object class="GtkBox">
                                <property name="margin-start">10</property>
                                <property name="margin-end">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Left Encoder:</property>
                                    <property name="hexpand">true</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="enc_left_val">
                                    <property name="label">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="margin-start">10</property>
                                <property name="margin-end">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Right Encoder:</property>
                                    <property name="hexpand">true</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="enc_right_val">
                                    <property name="label">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="margin-start">10</property>
                                <property name="margin-end">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Pose X (m):</property>
                                    <property name="hexpand">true</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="pose_x_val">
                                    <property name="label">0.00</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="margin-start">10</property>
                                <property name="margin-end">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Pose Y (m):</property>
                                    <property name="hexpand">true</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="pose_y_val">
                                    <property name="label">0.00</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="margin-start">10</property>
                                <property name="margin-end">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Theta (rad):</property>
                                    <property name="hexpand">true</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="pose_theta_val">
                                    <property name="label">0.00</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- IMU Data -->
                <child>
                  <object class="GtkExpander">
                    <property name="label">IMU Sensor</property>
                    <property name="expanded">false</property>
                    <child>
                      <object class="GtkFrame">
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="margin-start">10</property>
                            <property name="margin-end">10</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel" id="accel_label">
                                <property name="label">Accel: X: 0.00 Y: 0.00 Z: 0.00</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkDrawingArea" id="accel_plot">
                                <property name="content-height">60</property>
                                <property name="margin-bottom">10</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="gyro_label">
                                <property name="label">Gyro: X: 0.00 Y: 0.00 Z: 0.00</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkDrawingArea" id="gyro_plot">
                                <property name="content-height">60</property>
                                <property name="margin-bottom">10</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="mag_label">
                                <property name="label">Mag (Compass): X: 0.00 Y: 0.00 Z: 0.00</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkDrawingArea" id="mag_plot">
                                <property name="content-height">60</property>
                                <property name="margin-bottom">10</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Keyboard Shortcuts Help -->
                <child>
                  <object class="GtkExpander">
                    <property name="label">Keyboard Shortcuts</property>
                    <property name="expanded">false</property>
                    <child>
                      <object class="GtkFrame">
                        <child>
                          <object class="GtkLabel">
                            <property name="margin-start">10</property>
                            <property name="margin-end">10</property>
                            <property name="margin-top">10</property>
                            <property name="margin-bottom">10</property>
                            <property name="xalign">0</property>
                            <property name="label">WASD: Move Robot
Q/E: Rotate In-Place (L/R)
L: Toggle LiDAR
Space: STOP ALL
H: Toggle Sidebar</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Robot Logs -->
                <child>
                  <object class="GtkExpander">
                    <property name="label">Robot Logs</property>
                    <property name="expanded">true</property>
                    <child>
                      <object class="GtkFrame">
                        <child>
                          <object class="GtkScrolledWindow">
                            <property name="hscrollbar-policy">never</property>
                            <property name="vscrollbar-policy">automatic</property>
                            <property name="min-content-height">150</property>
                            <child>
                              <object class="GtkTextView" id="log_text_view">
                                <property name="focusable">false</property>
                                <property name="editable">false</property>
                                <property name="cursor-visible">false</property>
                                <property name="wrap-mode">word</property>
                                <property name="monospace">true</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <child type="end">
          <object class="GtkFrame">
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>
            <child>
              <object class="GtkDrawingArea" id="lidar_canvas">
                <property name="focusable">true</property>
                <property name="content-width">600</property>
                <property name="content-height">600</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
        <child type="overlay">
          <object class="GtkBox" id="loading_overlay">
            <property name="orientation">vertical</property>
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>
            <style>
              <class name="loading-overlay-bg"/>
            </style>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">24</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <child>
                  <object class="GtkSpinner" id="loading_spinner">
                    <property name="spinning">true</property>
                    <property name="width-request">80</property>
                    <property name="height-request">80</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="loading_label">
                    <property name="label">Waiting for Robot Connection...</property>
                    <style>
                      <class name="title-1"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="loading_instructions">
                    <property name="label">To establish a connection, please start the robot firmware:

• Hardware: Turn on the ESP32-C6 power switch (must be on the same Wi-Fi).
• Simulation: Run `./tools/start_sim.sh` or launch the Zephyr `zephyr.exe` binary.

The server is listening on port 12345.</property>
                    <property name="justify">center</property>
                    <style>
                      <class name="body"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
