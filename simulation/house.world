<?xml version="1.0" ?>
<sdf version="1.9">
    <world name="homerobot_world">
        <physics name="1ms" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>
        <plugin
            filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
        </plugin>
        <plugin
            filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
        </plugin>
        <plugin
            filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
        </plugin>
        <plugin
            filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
        <plugin
            filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
        </plugin>

        <gui fullscreen="0">
            <plugin filename="MinimalScene" name="3D View">
                <gz-gui>
                    <title>3D View</title>
                    <property type="bool" key="showTitleBar">false</property>
                    <property type="string" key="state">docked</property>
                </gz-gui>
                <engine>ogre2</engine>
                <scene>scene</scene>
                <sky></sky>
                <camera_clip>
                    <near>0.01</near>
                    <far>500</far>
                </camera_clip>
                <camera_pose>-5 0 2 0 0.4 0</camera_pose>
            </plugin>
            <plugin filename="GzSceneManager" name="Scene Manager">
                <gz-gui>
                    <property key="resizable" type="bool">false</property>
                    <property key="width" type="double">5</property>
                    <property key="height" type="double">5</property>
                    <property key="state" type="string">floating</property>
                    <property key="showTitleBar" type="bool">false</property>
                </gz-gui>
            </plugin>
            <plugin filename="InteractiveViewControl" name="Interactive view control">
                <gz-gui>
                    <property key="resizable" type="bool">false</property>
                    <property key="width" type="double">5</property>
                    <property key="height" type="double">5</property>
                    <property key="state" type="string">floating</property>
                    <property key="showTitleBar" type="bool">false</property>
                </gz-gui>
            </plugin>
            <plugin filename="CameraTracking" name="Camera Tracking">
                <gz-gui>
                    <property key="resizable" type="bool">false</property>
                    <property key="width" type="double">5</property>
                    <property key="height" type="double">5</property>
                    <property key="state" type="string">floating</property>
                    <property key="showTitleBar" type="bool">false</property>
                </gz-gui>
            </plugin>
            <plugin filename="WorldControl" name="World control">
                <gz-gui>
                    <title>World control</title>
                    <property type="bool" key="showTitleBar">false</property>
                    <property type="bool" key="resizable">false</property>
                    <property type="double" key="height">72</property>
                    <property type="double" key="width">121</property>
                    <property type="double" key="z">1</property>
                    <property type="string" key="state">floating</property>
                    <anchors target="3D View">
                        <line own="left" target="left"/>
                        <line own="bottom" target="bottom"/>
                    </anchors>
                </gz-gui>
                <play_pause>true</play_pause>
                <step>true</step>
                <start_paused>false</start_paused>
                <use_event_alt>true</use_event_alt>
            </plugin>
            <plugin filename="WorldStats" name="World stats">
                <gz-gui>
                    <title>World stats</title>
                    <property type="bool" key="showTitleBar">false</property>
                    <property type="bool" key="resizable">false</property>
                    <property type="double" key="height">110</property>
                    <property type="double" key="width">290</property>
                    <property type="double" key="z">1</property>
                    <property type="string" key="state">floating</property>
                    <anchors target="3D View">
                        <line own="right" target="right"/>
                        <line own="bottom" target="bottom"/>
                    </anchors>
                </gz-gui>
                <sim_time>true</sim_time>
                <real_time>true</real_time>
                <real_time_factor>true</real_time_factor>
                <iterations>true</iterations>
            </plugin>
            <plugin filename="EntityTree" name="Entity tree">
            </plugin>
        </gui>

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                        <specular>0.8 0.8 0.8 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- House: 4 rooms (bedroom, kitchen, living, study) with 0.9m
             door openings and furniture. Same world name as sim.world so
             the ground-truth topic and tooling stay identical. -->
        <model name="house">
            <static>true</static>
            <pose>0 0 0.5 0 0 0</pose>
            <link name="structure">
                <collision name="wall0">
                    <pose>0.0 4.0 0.0 0 0 0</pose>
                    <geometry><box><size>10.1 0.1 1.0</size></box></geometry>
                </collision>
                <visual name="wall0_visual">
                    <pose>0.0 4.0 0.0 0 0 0</pose>
                    <geometry><box><size>10.1 0.1 1.0</size></box></geometry>
                    <material><ambient>0.75 0.68 0.6 1</ambient><diffuse>0.75 0.68 0.6 1</diffuse></material>
                </visual>
                <collision name="wall1">
                    <pose>0.0 -4.0 0.0 0 0 0</pose>
                    <geometry><box><size>10.1 0.1 1.0</size></box></geometry>
                </collision>
                <visual name="wall1_visual">
                    <pose>0.0 -4.0 0.0 0 0 0</pose>
                    <geometry><box><size>10.1 0.1 1.0</size></box></geometry>
                    <material><ambient>0.75 0.68 0.6 1</ambient><diffuse>0.75 0.68 0.6 1</diffuse></material>
                </visual>
                <collision name="wall2">
                    <pose>-5.0 0.0 0.0 0 0 0</pose>
                    <geometry><box><size>0.1 8.1 1.0</size></box></geometry>
                </collision>
                <visual name="wall2_visual">
                    <pose>-5.0 0.0 0.0 0 0 0</pose>
                    <geometry><box><size>0.1 8.1 1.0</size></box></geometry>
                    <material><ambient>0.75 0.68 0.6 1</ambient><diffuse>0.75 0.68 0.6 1</diffuse></material>
                </visual>
                <collision name="wall3">
                    <pose>5.0 0.0 0.0 0 0 0</pose>
                    <geometry><box><size>0.1 8.1 1.0</size></box></geometry>
                </collision>
                <visual name="wall3_visual">
                    <pose>5.0 0.0 0.0 0 0 0</pose>
                    <geometry><box><size>0.1 8.1 1.0</size></box></geometry>
                    <material><ambient>0.75 0.68 0.6 1</ambient><diffuse>0.75 0.68 0.6 1</diffuse></material>
                </visual>
                <collision name="wall4">
                    <pose>-1.0 -2.35 0.0 0 0 0</pose>
                    <geometry><box><size>0.1 3.3 1.0</size></box></geometry>
                </collision>
                <visual name="wall4_visual">
                    <pose>-1.0 -2.35 0.0 0 0 0</pose>
                    <geometry><box><size>0.1 3.3 1.0</size></box></geometry>
                    <material><ambient>0.75 0.68 0.6 1</ambient><diffuse>0.75 0.68 0.6 1</diffuse></material>
                </visual>
                <collision name="wall5">
                    <pose>-1.0 1.1 0.0 0 0 0</pose>
                    <geometry><box><size>0.1 1.8 1.0</size></box></geometry>
                </collision>
                <visual name="wall5_visual">
                    <pose>-1.0 1.1 0.0 0 0 0</pose>
                    <geometry><box><size>0.1 1.8 1.0</size></box></geometry>
                    <material><ambient>0.75 0.68 0.6 1</ambient><diffuse>0.75 0.68 0.6 1</diffuse></material>
                </visual>
                <collision name="wall6">
                    <pose>-1.0 3.45 0.0 0 0 0</pose>
                    <geometry><box><size>0.1 1.1 1.0</size></box></geometry>
                </collision>
                <visual name="wall6_visual">
                    <pose>-1.0 3.45 0.0 0 0 0</pose>
                    <geometry><box><size>0.1 1.1 1.0</size></box></geometry>
                    <material><ambient>0.75 0.68 0.6 1</ambient><diffuse>0.75 0.68 0.6 1</diffuse></material>
                </visual>
                <collision name="wall7">
                    <pose>-4.15 1.0 0.0 0 0 0</pose>
                    <geometry><box><size>1.7 0.1 1.0</size></box></geometry>
                </collision>
                <visual name="wall7_visual">
                    <pose>-4.15 1.0 0.0 0 0 0</pose>
                    <geometry><box><size>1.7 0.1 1.0</size></box></geometry>
                    <material><ambient>0.75 0.68 0.6 1</ambient><diffuse>0.75 0.68 0.6 1</diffuse></material>
                </visual>
                <collision name="wall8">
                    <pose>-1.7 1.0 0.0 0 0 0</pose>
                    <geometry><box><size>1.4 0.1 1.0</size></box></geometry>
                </collision>
                <visual name="wall8_visual">
                    <pose>-1.7 1.0 0.0 0 0 0</pose>
                    <geometry><box><size>1.4 0.1 1.0</size></box></geometry>
                    <material><ambient>0.75 0.68 0.6 1</ambient><diffuse>0.75 0.68 0.6 1</diffuse></material>
                </visual>
                <collision name="wall9">
                    <pose>2.5 -2.6 0.0 0 0 0</pose>
                    <geometry><box><size>0.1 2.8 1.0</size></box></geometry>
                </collision>
                <visual name="wall9_visual">
                    <pose>2.5 -2.6 0.0 0 0 0</pose>
                    <geometry><box><size>0.1 2.8 1.0</size></box></geometry>
                    <material><ambient>0.75 0.68 0.6 1</ambient><diffuse>0.75 0.68 0.6 1</diffuse></material>
                </visual>
                <collision name="wall10">
                    <pose>2.8 -1.2 0.0 0 0 0</pose>
                    <geometry><box><size>0.6 0.1 1.0</size></box></geometry>
                </collision>
                <visual name="wall10_visual">
                    <pose>2.8 -1.2 0.0 0 0 0</pose>
                    <geometry><box><size>0.6 0.1 1.0</size></box></geometry>
                    <material><ambient>0.75 0.68 0.6 1</ambient><diffuse>0.75 0.68 0.6 1</diffuse></material>
                </visual>
                <collision name="wall11">
                    <pose>4.5 -1.2 0.0 0 0 0</pose>
                    <geometry><box><size>1.0 0.1 1.0</size></box></geometry>
                </collision>
                <visual name="wall11_visual">
                    <pose>4.5 -1.2 0.0 0 0 0</pose>
                    <geometry><box><size>1.0 0.1 1.0</size></box></geometry>
                    <material><ambient>0.75 0.68 0.6 1</ambient><diffuse>0.75 0.68 0.6 1</diffuse></material>
                </visual>
                <collision name="bed">
                    <pose>-3.8 2.7 -0.25 0 0 0</pose>
                    <geometry><box><size>1.6 1.9 0.5</size></box></geometry>
                </collision>
                <visual name="bed_visual">
                    <pose>-3.8 2.7 -0.25 0 0 0</pose>
                    <geometry><box><size>1.6 1.9 0.5</size></box></geometry>
                    <material><ambient>0.4 0.5 0.8 1</ambient><diffuse>0.4 0.5 0.8 1</diffuse></material>
                </visual>
                <collision name="wardrobe">
                    <pose>-1.45 3.5 0.0 0 0 0</pose>
                    <geometry><box><size>0.6 1.0 1.0</size></box></geometry>
                </collision>
                <visual name="wardrobe_visual">
                    <pose>-1.45 3.5 0.0 0 0 0</pose>
                    <geometry><box><size>0.6 1.0 1.0</size></box></geometry>
                    <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.5 0.35 0.2 1</diffuse></material>
                </visual>
                <collision name="kitchen_counter">
                    <pose>-4.65 -1.5 -0.04999999999999999 0 0 0</pose>
                    <geometry><box><size>0.6 3.0 0.9</size></box></geometry>
                </collision>
                <visual name="kitchen_counter_visual">
                    <pose>-4.65 -1.5 -0.04999999999999999 0 0 0</pose>
                    <geometry><box><size>0.6 3.0 0.9</size></box></geometry>
                    <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material>
                </visual>
                <collision name="fridge">
                    <pose>-4.55 -3.5 0.0 0 0 0</pose>
                    <geometry><box><size>0.8 0.8 1.0</size></box></geometry>
                </collision>
                <visual name="fridge_visual">
                    <pose>-4.55 -3.5 0.0 0 0 0</pose>
                    <geometry><box><size>0.8 0.8 1.0</size></box></geometry>
                    <material><ambient>0.85 0.85 0.9 1</ambient><diffuse>0.85 0.85 0.9 1</diffuse></material>
                </visual>
                <collision name="chair_k1">
                    <pose>-3.3 -2.2 -0.275 0 0 0</pose>
                    <geometry><box><size>0.4 0.4 0.45</size></box></geometry>
                </collision>
                <visual name="chair_k1_visual">
                    <pose>-3.3 -2.2 -0.275 0 0 0</pose>
                    <geometry><box><size>0.4 0.4 0.45</size></box></geometry>
                    <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material>
                </visual>
                <collision name="chair_k2">
                    <pose>-1.7 -2.2 -0.275 0 0 0</pose>
                    <geometry><box><size>0.4 0.4 0.45</size></box></geometry>
                </collision>
                <visual name="chair_k2_visual">
                    <pose>-1.7 -2.2 -0.275 0 0 0</pose>
                    <geometry><box><size>0.4 0.4 0.45</size></box></geometry>
                    <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material>
                </visual>
                <collision name="sofa">
                    <pose>1.6 3.45 -0.15000000000000002 0 0 0</pose>
                    <geometry><box><size>2.0 0.9 0.7</size></box></geometry>
                </collision>
                <visual name="sofa_visual">
                    <pose>1.6 3.45 -0.15000000000000002 0 0 0</pose>
                    <geometry><box><size>2.0 0.9 0.7</size></box></geometry>
                    <material><ambient>0.3 0.55 0.35 1</ambient><diffuse>0.3 0.55 0.35 1</diffuse></material>
                </visual>
                <collision name="coffee_table">
                    <pose>1.6 2.2 -0.3 0 0 0</pose>
                    <geometry><box><size>1.1 0.6 0.4</size></box></geometry>
                </collision>
                <visual name="coffee_table_visual">
                    <pose>1.6 2.2 -0.3 0 0 0</pose>
                    <geometry><box><size>1.1 0.6 0.4</size></box></geometry>
                    <material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material>
                </visual>
                <collision name="tv_stand">
                    <pose>4.6 1.5 -0.25 0 0 0</pose>
                    <geometry><box><size>0.5 1.6 0.5</size></box></geometry>
                </collision>
                <visual name="tv_stand_visual">
                    <pose>4.6 1.5 -0.25 0 0 0</pose>
                    <geometry><box><size>0.5 1.6 0.5</size></box></geometry>
                    <material><ambient>0.25 0.25 0.3 1</ambient><diffuse>0.25 0.25 0.3 1</diffuse></material>
                </visual>
                <collision name="desk">
                    <pose>4.35 -3.4 -0.125 0 0 0</pose>
                    <geometry><box><size>1.2 0.6 0.75</size></box></geometry>
                </collision>
                <visual name="desk_visual">
                    <pose>4.35 -3.4 -0.125 0 0 0</pose>
                    <geometry><box><size>1.2 0.6 0.75</size></box></geometry>
                    <material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material>
                </visual>
                <collision name="kitchen_table">
                    <pose>-2.5 -2.2 -0.125 0 0 0</pose>
                    <geometry><cylinder><radius>0.55</radius><length>0.75</length></cylinder></geometry>
                </collision>
                <visual name="kitchen_table_visual">
                    <pose>-2.5 -2.2 -0.125 0 0 0</pose>
                    <geometry><cylinder><radius>0.55</radius><length>0.75</length></cylinder></geometry>
                    <material><ambient>0.65 0.5 0.35 1</ambient><diffuse>0.65 0.5 0.35 1</diffuse></material>
                </visual>
                <collision name="plant">
                    <pose>-0.5 -3.5 -0.04999999999999999 0 0 0</pose>
                    <geometry><cylinder><radius>0.25</radius><length>0.9</length></cylinder></geometry>
                </collision>
                <visual name="plant_visual">
                    <pose>-0.5 -3.5 -0.04999999999999999 0 0 0</pose>
                    <geometry><cylinder><radius>0.25</radius><length>0.9</length></cylinder></geometry>
                    <material><ambient>0.2 0.6 0.25 1</ambient><diffuse>0.2 0.6 0.25 1</diffuse></material>
                </visual>
                <collision name="desk_chair">
                    <pose>3.9 -2.9 -0.25 0 0 0</pose>
                    <geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
                </collision>
                <visual name="desk_chair_visual">
                    <pose>3.9 -2.9 -0.25 0 0 0</pose>
                    <geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
                    <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material>
                </visual>
            </link>
        </model>

        <!-- Include the robot -->
        <include>
            <uri>model://homerobot</uri>
            <name>homerobot</name>
            <pose>1 0.5 0.1 0 0 0</pose>
        </include>
    </world>
</sdf>
